# Hosted Vercel deployment. Use separate values/resources for preview and production.
X_HOSTED_ORIGIN=https://your-project.vercel.app
# X OAuth 2.0 Web App (confidential client), not a Native App.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Numeric X IDs separated by commas. Explicitly use * only for public access.
X_ALLOWED_USER_IDS=
# 32 random bytes, hex encoded. Store securely; never commit this value.
X_TOKEN_ENCRYPTION_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace's KV_REST_API_URL and KV_REST_API_TOKEN are also supported.
